:root {
}

.boton {
    width: 28%;
    height: 13%;
    align-items: stretch;
    align-content: flex-start;
    align-self: center;
    justify-content: flex-start;
    font-size: 45px;
    background-image: url("project://database/Assets/Saurabh_Studio/UI%20button%20and%20hallowing%20element%20pack%205/Button%206/7.png?fileID=2800000&guid=d3dd507249881854fbaa9d44a29f0d89&type=3#7");
    background-size: 400px 200px;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(254, 253, 253);
    display: none;
}

.boton:hover {
    transition-duration: 0.5s;
    scale: 1.15 1.15;
}



.boton:active {
    -unity-background-image-tint-color: rgba(7, 7, 7, 0.49);
    transition-duration: 0.5s;
}
